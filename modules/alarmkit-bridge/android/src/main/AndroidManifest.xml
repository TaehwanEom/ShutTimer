<!-- 알람 엔진 권한/컴포넌트 선언 — 빌드 시 앱(com.shuttimer.app) manifest에 자동 병합됨. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Android 16+ Live Updates (Notification.ProgressStyle) 측 promoted ongoing notification 권한.
         routine 진행 중 잠금화면 정중앙 promoted 표시 (= iOS Live Activity 가장 가까운 형태). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <application>
        <!-- 알람 발화 수신기 — AlarmManager가 예약 시각에 broadcast. 외부 노출 불필요 → exported=false -->
        <receiver
            android:name="expo.modules.alarmkitbridge.AlarmReceiver"
            android:exported="false"/>
        <!-- Phase 3-3: FSI notification 측 secondary action button (= "다음 진행") 측 broadcast 수신.
             내부 알림 측 PendingIntent 측만 발송 → exported=false. -->
        <receiver
            android:name="expo.modules.alarmkitbridge.AlarmActionReceiver"
            android:exported="false"/>
        <!-- 알람 발화 서비스 — foreground service. 소리·진동·전체화면 알림. -->
        <service
            android:name="expo.modules.alarmkitbridge.AlarmService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false"/>
        <!-- 재부팅 복원 수신기 — 부팅 완료 시 소실된 AlarmManager 예약 재등록. 시스템 broadcast 수신 → exported 필수. -->
        <receiver
            android:name="expo.modules.alarmkitbridge.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
        <!-- 전체화면 알람용 — 앱 MainActivity가 잠금화면 위에 뜨도록 속성 병합.
             2026-05-31: AlarmAlertActivity 도입 후에도 미션 알람 끄기 시 MainActivity 진입에 잠금 위 표시 필요. -->
        <activity
            android:name="com.shuttimer.app.MainActivity"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            tools:node="merge"/>
        <!-- 알람 발화 전용 Activity — 잠금/홈 위 가벼운 화면. 사용자 "끄기" 누름 후 MainActivity 진입.
             theme = Translucent.NoTitleBar → dim 배경 + 흰 카드 sheet 형태 (= ShutTimer 표준 모달 정합). -->
        <activity
            android:name="expo.modules.alarmkitbridge.AlarmAlertActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"/>
    </application>
</manifest>
